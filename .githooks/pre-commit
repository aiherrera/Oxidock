#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
# shellcheck source=scripts/git-hooks-lib.sh
source "$repo_root/scripts/git-hooks-lib.sh"

cd "$repo_root"

if git diff --cached --quiet; then
  exit 0
fi

originally_staged=()
while IFS= read -r path; do
  [[ -n "$path" ]] && originally_staged+=("$path")
done < <(git diff --cached --name-only)

dirty_before=()
while IFS= read -r path; do
  [[ -n "$path" ]] && dirty_before+=("$path")
done < <(git diff --name-only)

echo "Running full-project lint and format fix (pnpm lint:fix)..."
pnpm lint:fix

echo "Formatting Rust code..."
pnpm rust:format

echo "Running tests..."
pnpm test
echo -e "${GREEN}✔ All tests passed${NC}"

echo "Re-staging commit and auto-fixed files..."
for path in "${originally_staged[@]}"; do
  [[ -n "$path" ]] && git add -- "$path"
done

while IFS= read -r path; do
  [[ -z "$path" ]] && continue

  for staged_path in "${originally_staged[@]}"; do
    [[ "$path" == "$staged_path" ]] && continue 2
  done

  for dirty_path in "${dirty_before[@]}"; do
    [[ "$path" == "$dirty_path" ]] && continue 2
  done

  git add -- "$path"
done < <(git diff --name-only)

echo -e "${GREEN}✔ Pre-commit checks passed${NC}"
