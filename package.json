{
  "name": "oxidock",
  "private": true,
  "version": "0.5.0",
  "description": "A desktop Docker manager built with Tauri 2 and React 19",
  "author": "Alain Iglesias",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiherrera/oxidock"
  },
  "homepage": "https://oxidock.com",
  "bugs": {
    "url": "https://github.com/aiherrera/oxidock/issues"
  },
  "keywords": [
    "docker",
    "desktop",
    "manager",
    "tauri",
    "react",
    "rust"
  ],
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "pnpm audit --prod",
    "check": "pnpm lint && pnpm rust:format:check && pnpm typecheck && pnpm test && pnpm build",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "postinstall": "sh scripts/install-git-hooks.sh",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
    "rust:format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint": "eslint . && pnpm format:check",
    "lint:fix": "eslint . --fix && pnpm format",
    "preview": "vite preview",
    "tauri": "tauri",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.193",
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "react-doctor": "^0.2.16",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
