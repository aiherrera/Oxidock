{
  "name": "oxidock",
  "private": true,
  "version": "0.2.0",
  "description": "A desktop Docker manager built with Tauri 2 and React 19",
  "author": "Alain Iglesias",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiherrera/oxidock"
  },
  "homepage": "https://oxidock.com",
  "bugs": {
    "url": "https://github.com/aiherrera/oxidock/issues"
  },
  "keywords": [
    "docker",
    "desktop",
    "manager",
    "tauri",
    "react",
    "rust"
  ],
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "pnpm audit --prod",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "postinstall": "sh scripts/install-git-hooks.sh",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . && pnpm format:check",
    "lint:fix": "eslint . --fix && pnpm format",
    "preview": "vite preview",
    "tauri": "tauri",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "react-doctor": "^0.2.8",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
